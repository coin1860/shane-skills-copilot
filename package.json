{
  "name": "shane-skills",
  "displayName": "Shane Skills for GitHub Copilot",
  "description": "Shane Skills — a curated VS Code extension that brings composable development skills (TDD, brainstorming, subagent-driven development, systematic debugging, and more) natively into GitHub Copilot. Auto-injects skills via copilot-instructions and .agent.md on activation.",
  "version": "1.0.0",
  "publisher": "shane-h-shou",
  "author": {
    "name": "Shane H SHOU"
  },
  "license": "MIT",
  "icon": "assets/superpowers-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/shane-h-shou/shane-skills"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "copilot",
    "ai",
    "skills",
    "tdd",
    "debugging",
    "brainstorming",
    "shane-skills",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "superpowers.agent",
        "name": "superpowers",
        "fullName": "Superpowers Agent",
        "description": "Superpowers agent for structured development workflows.",
        "isSticky": false,
        "commands": [
          {
            "name": "skills",
            "description": "List all available Superpowers skills"
          },
          {
            "name": "brainstorm",
            "description": "Explore your idea collaboratively before writing code"
          },
          {
            "name": "plan",
            "description": "Write a bite-sized implementation plan"
          },
          {
            "name": "debug",
            "description": "Apply systematic 4-phase debugging"
          },
          {
            "name": "tdd",
            "description": "Follow Red-Green-Refactor TDD cycle"
          },
          {
            "name": "review",
            "description": "Request a pre-merge code review"
          },
          {
            "name": "setup",
            "description": "Install Superpowers files (.copilot-instructions, .agent.md) into your workspace"
          }
        ]
      }
    ],

    "configuration": {
      "title": "Shane Skills for Copilot",
      "properties": {
        "superpowers.skillsSource": {
          "type": "string",
          "enum": [
            "bundled",
            "local"
          ],
          "default": "bundled",
          "description": "Where to load skills from. 'bundled' uses skills shipped with this extension; 'local' reads from a local shane-skills clone.",
          "enumDescriptions": [
            "Use skills bundled with this extension (recommended)",
            "Load skills from a local shane-skills repository clone"
          ]
        },
        "superpowers.localSkillsPath": {
          "type": "string",
          "default": "",
          "description": "Path to a local shane-skills repository (only used when skillsSource is 'local'). Example: /Users/you/Dev/shane-skills"
        },
        "superpowers.autoSetupWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "On activation, automatically offer to create .github/copilot-instructions.md and .github/agents/ in the current workspace."
        }
      }
    },
    "commands": [
      {
        "command": "superpowers.setupWorkspace",
        "title": "Setup Workspace (create copilot-instructions & agent files)",
        "category": "Shane-Skills"
      },
      {
        "command": "superpowers.openSkillsPanel",
        "title": "Open Skills Browser",
        "category": "Shane-Skills"
      },
      {
        "command": "superpowers.openAgentsBrowser",
        "title": "Open Agent Browser",
        "category": "Shane-Skills"
      },
      {
        "command": "superpowers.reloadSkills",
        "title": "Reload Skills",
        "category": "Shane-Skills"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "lint": "eslint src",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/marked": "^5.0.2",
    "@types/node": "^22.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.x",
    "@typescript-eslint/parser": "^8.x",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^9.x",
    "typescript": "^5.7.x"
  },
  "dependencies": {}
}